After=network.target

[Service]
Type=simple
ExecStartPre=/bin/mkdir -p /var/run/lirc
ExecStart=/usr/sbin/eventlircd -f -e /etc/eventlircd.d
Restart=on-failure

[Install]
WantedBy=multi-user.target
EOF
