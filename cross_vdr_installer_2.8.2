#
clear
yourch=$(whiptail --title "Vdr Automatic start" --menu "Select option:" 15 60 3 \
    "a" "Vdr auto start" \
    "b" "No auto start" \
    "S" "Skip" \
    3>&1 1>&2 2>&3)
#
    [ $? -ne 0 ] && break
    case $yourch in
a)
clear
echo "                    Automatic start Vdr" # da cambiare
cd /home/`logname`/.config/autostart
rm -rf vdr-autostart.desktop
systemctl enable vdr
whiptail --msgbox "Automatic start Vdr installed" 8 45 ;;
#
b) clear;;
#
S) clear;;
esac
#
echo "                    *** All things Done! ***"
sleep 3
whiptail --msgbox "Installation completed!" 8 45
break
esac
done;;
#
X)
clear
exit 0
;;
*) ;;
esac
done
